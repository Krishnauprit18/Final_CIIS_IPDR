# Local CIIS development configuration.
# Never place real secrets in this file.

FRONTEND_ORIGIN=http://localhost:3000

# Optional map provider token. Leave empty for local OpenStreetMap/Leaflet usage.
MAPBOX_TOKEN=

# Optional local LLM configuration.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Used only when starting backend/main.py directly.
HOST=127.0.0.1
PORT=8000
