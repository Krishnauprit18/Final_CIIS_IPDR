# Local CIIS development configuration.
# Never place real secrets in this file.

FRONTEND_ORIGIN=http://localhost:3000

# Optional map provider token. Leave empty for local OpenStreetMap/Leaflet usage.
MAPBOX_TOKEN=

# Optional local LLM configuration.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Used only when starting backend/main.py directly.
HOST=127.0.0.1
PORT=8000

# PostgreSQL persistence (Phase 2)
DATABASE_URL=postgresql+psycopg://ciis:ciis@localhost:5432/ciis

# S3-compatible object storage (Phase 3)
# Local development uses MinIO. For AWS S3, leave STORAGE_ENDPOINT_URL empty
# and provide credentials through the normal AWS credential chain/IAM role.
STORAGE_BUCKET=ciis-storage
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=ciisadmin
STORAGE_SECRET_KEY=ciisadmin123
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
